# Public URL of the site, used for share previews and canonical links.
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Where the map files live (basemap and terrain PMTiles). Defaults to the public CDN, so a fresh
# clone shows real maps; point it at a local folder in public/ to test new extracts.
NEXT_PUBLIC_TILES_URL=https://tiles.trailaroo.com
